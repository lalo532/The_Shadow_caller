    old "Admirar la vista en silencio y coquetear."
    new "Silently admire the view and flirt."

    # game/events/roxane.rpy:89
    old "Hacerle compañía"
    new "Keep her company"

    # game/events/roxane.rpy:96
    old "Dejarla sola"
    new "Leave her alone"