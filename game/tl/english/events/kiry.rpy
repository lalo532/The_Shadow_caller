    # kiry "¡[mc_name]! Ven a jugar conmigo, me aburro muchísimo."
    kiry "[mc_name]! Come play with me, I'm so bored."

# game/events/kiry.rpy:14
translate english loc_cuarto_kiry_b3496ece:

    # mc "Tengo cosas que hacer, [h_menor_name]."
    mc "I have things to do, [h_menor_name]."

# game/events/kiry.rpy:15
translate english loc_cuarto_kiry_7886b371:

    # kiry "No seas amargado. Si te quedas, te dejo que me ayudes a elegir qué pijama ponerme."
    kiry "Don't be so grumpy. If you stay, I'll let you help me choose which pajamas to wear."

# game/events/kiry.rpy:17
translate english loc_cuarto_kiry_ee7a7d11:

    # narrador "El cuarto de [h_menor_name] es un caos de peluches y cargadores de celular."
    narrador "[h_menor_name]'s room is a mess of stuffed animals and phone chargers."

# game/events/kiry.rpy:27
translate english evento_platica_kiry_39d8867d:

    # narrador "[h_menor_name] está sentada en el sofá, moviendo los pies de forma impaciente y jugando con su cabello."
    narrador "[h_menor_name] is sitting on the couch, impatiently swinging her feet and playing with her hair."

# game/events/kiry.rpy:30
translate english evento_platica_kiry_9fdbc902:

    # kiry "¡Al fin sales de tu cueva, [mc_name]! Ven, siéntate aquí un rato."
    kiry "Finally you come out of your cave, [mc_name]! Come sit here for a while."

# game/events/kiry.rpy:33
translate english evento_platica_kiry_c2275316:

    # mc "¿Qué mosca te picó ahora?"
    mc "What's gotten into you now?"

# game/events/kiry.rpy:36
translate english evento_platica_kiry_7d3e6d70:

    # kiry "Estoy aburrida. Ya me cansé de ver las paredes y el techo. Dame algo de atención."
    kiry "I'm bored. I'm tired of staring at the walls and ceiling. Give me some attention."

# game/events/kiry.rpy:39
translate english evento_platica_kiry_53b4553a:

    # kiry "Dime la verdad... ¿Crees que me estoy viendo fea con tanto encierro? Siento que parezco un oso desaliñado."
    kiry "Tell me the truth... Do you think I look ugly from being locked up so much? I feel like a messy bear."

# game/events/kiry.rpy:45
translate english evento_platica_kiry_200b23e9:

    # mc "Tranquila, te ves linda. El encierro no te ha quitado lo atractiva."
    mc "Relax, you look cute. Being locked up hasn't made you any less attractive."

# game/events/kiry.rpy:46
translate english evento_platica_kiry_ab476698:

    # kiry "Aww... sabía que en el fondo no eras tan insensible de roca. Gracias, [mc_name]."
    kiry "Aww... I knew deep down you weren't such a cold rock. Thanks, [mc_name]."

# game/events/kiry.rpy:47
translate english evento_platica_kiry_29dad077:

    # narrador "Te regala una sonrisa genuina y se acurruca un poco más cerca de ti en el sofá, buscando tu calor."
    narrador "She gives you a genuine smile and snuggles a little closer to you on the couch, seeking your warmth."

# game/events/kiry.rpy:52
translate english evento_platica_kiry_2504a1d2:

    # mc "Te ves igual de mandona y desordenada que siempre. Deja de quejarte."
    mc "You look just as bossy and messy as always. Stop complaining."

# game/events/kiry.rpy:53
translate english evento_platica_kiry_347c2674:

    # kiry "¡Oye! Eres un amargado de lo peor. Ojalá te congeles en el pasillo."
    kiry "Hey! You're the grumpiest person ever. I hope you freeze in the hallway."

# game/events/kiry.rpy:54
translate english evento_platica_kiry_751ed82b:

    # narrador "Cruza los brazos, hace un puchero ofendida y se voltea hacia el otro lado indignada."
    narrador "She crosses her arms, makes an offended pout, and turns to the other side indignantly."

# game/events/kiry.rpy:65
translate english evento_kiry_cama_fb2c2968:

    # kiry "¡Despierta, [mc_name]! Me aburro."
    kiry "Wake up, [mc_name]! I'm bored."

# game/events/kiry.rpy:66
translate english evento_kiry_cama_d232c107:

    # mc "¿Qué quieres, enana?"
    mc "What do you want, shorty?"

# game/events/kiry.rpy:67
translate english evento_kiry_cama_cca051a0:

    # kiry "No me digas enana. Tengo frío, hazme un espacio."
    kiry "Don't call me shorty. I'm cold, make some space for me."

# game/events/kiry.rpy:68
translate english evento_kiry_cama_18a7d830:

    # narrador "Se mete bajo tus sábanas antes de que puedas protestar, pegando sus piernas frías a las tuyas."
    narrador "She slips under your sheets before you can protest, pressing her cold legs against yours."

